rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'sieqz9C2ZGW9xrMKlhgj0jO543X2'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    match /published/{date}/{uploadId}/{fileName} {
      allow get: if true;
      allow list: if false;
      allow create: if isOwner() && resource == null && (
        (fileName == 'photo.jpg' && request.resource.contentType == 'image/jpeg'
          && request.resource.size <= 800 * 1024)
        || (fileName == 'thumbnail.jpg' && request.resource.contentType == 'image/jpeg'
          && request.resource.size <= 100 * 1024)
        || (fileName == 'recording' && request.resource.contentType.matches('audio/.*')
          && request.resource.size <= 5 * 1024 * 1024)
      );
      // A kept moment includes its files: neither replacement nor deletion is allowed.
      allow update: if false;
      allow delete: if false;
    }
    match /{other=**} { allow read, write: if false; }
  }
}
